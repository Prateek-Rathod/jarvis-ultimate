{
  "name": "jarvis-ultimate",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --workspace @jarvis/api\" \"npm run dev --workspace @jarvis/web\"",
    "build": "npm run build --workspace @jarvis/api && npm run build --workspace @jarvis/web",
    "typecheck": "npm run typecheck --workspace @jarvis/api && npm run typecheck --workspace @jarvis/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint \"apps/**/*.{ts,tsx}\"",
    "format": "prettier --write package.json \"apps/**/*.{ts,tsx,css,html,json,md}\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check package.json \"apps/**/*.{ts,tsx,css,html,json,md}\" \"*.md\" \"docs/**/*.md\"",
    "db:generate": "npm run db:generate --workspace @jarvis/api",
    "db:migrate": "npm run db:migrate --workspace @jarvis/api",
    "db:deploy": "npm run db:deploy --workspace @jarvis/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
